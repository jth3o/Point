# Server-side only. Never expose to frontend.
OPENAI_API_KEY=sk-...

# MongoDB connection string (server-side only).
MONGODB_URI=mongodb://localhost:27017/point

# Auth.js (Google OAuth).
AUTH_SECRET=          # required; generate with: npx auth secret
AUTH_GOOGLE_ID=       # from Google Cloud Console OAuth 2.0 Client ID
AUTH_GOOGLE_SECRET=   # from Google Cloud Console OAuth 2.0 Client secret

# Optional: default user for MVP (no auth in Phase 1–2).
# NEXT_PUBLIC_DEFAULT_USER_ID=
